<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MovieExplorer"
             x:Class="MovieExplorer.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Default text color -->
            <Color x:Key="TextColor">#000000</Color>
            <!-- Default frame background -->
            <Color x:Key="ThemeBGColorFrame">#B8860B</Color>

            <!-- Default background Color -->
            <Color x:Key="PageBackgroundColor">#F2E6C7</Color>

            <!-- Default favourite Icon -->
            <x:String x:Key="FavouriteIcon">love_icon.png</x:String>
            
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

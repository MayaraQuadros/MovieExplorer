<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MovieExplorer.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MovieExplorer"
    Title="MovieExplorer"
    Shell.FlyoutBehavior="Flyout">

   
    <ShellContent
        Title="Movies"
       
        Route="MoviesMainPage" 
        x:Name="HomeMovies">
        <local:MainPage>
            <x:Arguments>
                <x:String>https://raw.githubusercontent.com/MayaraQuadros/MovieExplorer/refs/heads/main/MovieExplorer/Resources/Raw/list_movies.json</x:String>
            </x:Arguments>
        </local:MainPage>
    </ShellContent>
    <FlyoutItem Title="Settings">
        <ShellContent
             Title="Settings"
             ContentTemplate="{DataTemplate local:SettingsPage}"
             Route="SettingsPage" />
    </FlyoutItem>
    <FlyoutItem Title="Favourites">
        <ShellContent
  Title="Favourites"
  ContentTemplate="{DataTemplate local:FavouritePage}"
  Route="FavouritePage" />
    </FlyoutItem>
   


</Shell>

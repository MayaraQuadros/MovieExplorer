<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MovieExplorer.MainPage"
             BackgroundColor="{DynamicResource PageBackgroundColor}">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="LightBackgroundColor">#FAFAFA</Color>
            <!--Light mode color-->
            <Color x:Key="DarkBackgroundColor">#181818</Color>
            <!--Dark mode color-->

            <Color x:Key="PageBackgroundColor">#181818</Color>
            <Color x:Key="ThemeButton" >Black</Color>
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <ScrollView>
        <VerticalStackLayout>
            <SearchBar x:Name="searchBarEntry" Placeholder="Search for..."
                      SearchButtonPressed="SearchBar_SearchButtonPressed"/>
            <Label x:Name="lblresultSearch"/>
            <Label x:Name="lblFile"/>
            <Button x:Name="ToggleThemeButton" Text="Toggle Theme" Margin="0,20,0,20"
                   Clicked="ToggleThemeButton_Clicked" FontAttributes="Bold"
                    WidthRequest="150"/>
            <Label x:Name="lblMoviesList" Text="Movies List" HorizontalOptions="Center"
                   Margin="0,20,0,0" FontSize="Large"/>
            <Grid x:Name="GridMovies" BackgroundColor="DarkBlue">
                <CollectionView ItemsSource="{Binding FilteredMovies}"
                           SelectionMode="Single" 
                           SelectedItem="{Binding selectedMovie}"
                           SelectionChanged="CollectionView_SelectionChanged">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <StackLayout Padding="10">
                                <Label Text="{Binding Title}" FontSize="Large" FontAttributes="Bold"/>
                                <Label Text="{Binding Year}" FontSize="Small"/>
                                <Label Text="{Binding Genre}" FontSize="Small"/>
                                <Label Text="{Binding Director}" FontSize="Small"/>
                                <Label Text="{Binding Imdb}" FontSize="Small"/>
                                <Label Text="{Binding Cover}" FontSize="Small"/>
                            </StackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </Grid>
   


           
            

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

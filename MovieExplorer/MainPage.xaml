<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MovieExplorer.MainPage"
             BackgroundColor="{DynamicResource PageBackgroundColor}">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="LightBackgroundColor">#FAFAFA</Color> <!--Light mode color-->
            <Color x:Key="DarkBackgroundColor">#181818</Color> <!--Dark mode color-->

            <Color x:Key="PageBackgroundColor">#181818</Color>
            <Color x:Key="ThemeButton" >Black</Color>
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <ScrollView>
        <VerticalStackLayout>
            <Button x:Name="ToggleThemeButton" Text="Toggle Theme" Margin="0,20,0,20"
                   Clicked="ToggleThemeButton_Clicked" FontAttributes="Bold"
                    WidthRequest="150"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

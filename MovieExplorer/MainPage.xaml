<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MovieExplorer.MainPage"
             BackgroundColor="{DynamicResource PageBackgroundColor}">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="LightBackgroundColor">#FAFAFA</Color>
            <!--Light mode color-->
            <Color x:Key="DarkBackgroundColor">#181818</Color>
            <!--Dark mode color-->

            <Color x:Key="PageBackgroundColor">#FAFAFA</Color>
            
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <ScrollView>
        <VerticalStackLayout>
            <HorizontalStackLayout Spacing="40">
                <SearchBar x:Name="searchBarEntry" Placeholder="Search movies by Title, Genre, Year, Director or IMDB rating"
                    TextChanged="searchBarEntry_TextChanged"  HorizontalOptions="Start" WidthRequest="500" TextColor="Black"/>
                <Button x:Name="ToggleThemeButton" Text="Toggle Theme" 
                        Clicked="ToggleThemeButton_Clicked" FontAttributes="Bold" 
                        WidthRequest="150"/>
                <Button x:Name="favouriteListBtn" Text="Favourites" 
                        Clicked="favouriteListBtn_Clicked"
                        FontAttributes="Bold" 
                        WidthRequest="150"/>    

            </HorizontalStackLayout>
            <Label x:Name="lblDebugger" Text="{Binding Message}" TextColor="Black"/>
            <Label x:Name="lblMoviesList" Text="Movies" HorizontalOptions="Center"
                   Margin="0,40,0,40" FontSize="Large" TextColor="Black"/>
            <Grid x:Name="GridMovies" BackgroundColor="LightGreen">
                <CollectionView ItemsSource="{Binding FilteredMovies}"
                           SelectionMode="Single" 
                           SelectedItem="{Binding selectedMovie}"
                           SelectionChanged="CollectionView_SelectionChanged">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <StackLayout Padding="10">
                                <Label Text="{Binding Title}" FontSize="Large" FontAttributes="Bold"/>
                                <Label Text="{Binding Year}" FontSize="Small"/>
                                <Label Text="{Binding Genre}" FontSize="Small"/>
                                <Label Text="{Binding Director}" FontSize="Small"/>
                                <Label Text="{Binding Imdb}" FontSize="Small"/>
                                <Label Text="{Binding Cover}" FontSize="Small"/>
                                <Button x:Name="favouriteMoviebtn" Text="Favourite" 
                                        Clicked="favouriteMovieBtn_Clicked" WidthRequest="100" HorizontalOptions="Start"
                                        Margin="0,10,0,0"/>
                            </StackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                

            </Grid>
   


           
            

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

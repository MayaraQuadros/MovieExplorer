<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MovieExplorer.MainPage"
             BackgroundColor="{DynamicResource PageBackgroundColor}">
    
    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="LightBackgroundColor">#FAFAFA</Color>
            <!--Light mode color-->
            <Color x:Key="DarkBackgroundColor">#181818</Color>
            <!--Dark mode color-->

            <Color x:Key="PageBackgroundColor">#FAFAFA</Color>
            
           
        </ResourceDictionary>
    </ContentPage.Resources>
    
    <ScrollView>
        <VerticalStackLayout>
            <HorizontalStackLayout Spacing="40">
                <SearchBar x:Name="searchBarEntry" Placeholder="Search movies by Title, Genre, Year, Director or IMDB rating"
                    TextChanged="searchBarEntry_TextChanged"  HorizontalOptions="Start" WidthRequest="500" TextColor="Black"/>
                <Button x:Name="ToggleThemeButton" Text="Toggle Theme" 
                        Clicked="ToggleThemeButton_Clicked" FontAttributes="Bold" 
                        WidthRequest="150"/>
                <Button x:Name="favouriteListBtn" Text="Favourites" 
                        Clicked="favouriteListBtn_Clicked"
                        FontAttributes="Bold" 
                        WidthRequest="150"/>
                <!-- Settings button -->
                <Button Text="Settings"
                AbsoluteLayout.LayoutBounds="10,10,100,50"
                AbsoluteLayout.LayoutFlags="None"
                Clicked="OnSettings_Clicked"/>

            </HorizontalStackLayout>
            <Label x:Name="lblDebugger" Text="{Binding Message}" TextColor="Black"/>
            <Label x:Name="lblUsername" HorizontalOptions="Center" TextColor="Black"/>
            <Label x:Name="lblMoviesList" Text="Movies" IsVisible="False"
                   HorizontalOptions="Center"
                   Margin="0,40,0,40" FontSize="Large" TextColor="Black"/>
            
                <CollectionView ItemsSource="{Binding FilteredMovies}"
                           SelectionMode="Single" 
                           SelectedItem="{Binding selectedMovie}"
                           SelectionChanged="CollectionView_SelectionChanged">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical"
                                         Span="2"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Margin="8"
                                   Padding="10"
                                   CornerRadius="12"
                                   BorderColor="LightGray"
                                   BackgroundColor="BlanchedAlmond">
                                

                                <Grid RowDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Row="0" Spacing="4">
                                        <Label Text="{Binding Title}" FontSize="35" HorizontalOptions="Center" FontAttributes="Bold"/>
                                        <Label Text="{Binding Year}"  HorizontalOptions="Center" FontSize="20"/>
                                        <Label Text="{Binding Genre}"  HorizontalOptions="Center" FontSize="20"/>
                                        <Label Text="{Binding Director}"  HorizontalOptions="Center" FontSize="20"/>
                                        <Label Text="{Binding Imdb, StringFormat='⭐ {0}'}"  HorizontalOptions="Center" FontSize="20"/>
                                        <Label Text="{Binding Cover}"  HorizontalOptions="Center" FontSize="20"/>
                                    </VerticalStackLayout>

                                    
                                    <ImageButton Source="love.png"
                                                 Clicked="favouriteMovieBtn_Clicked"
                                                 Grid.Row="1"
                                                 WidthRequest="15"
                                                 HeightRequest="15"
                                                 BackgroundColor="Transparent"
                                                 HorizontalOptions="Start"/>

                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
           
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

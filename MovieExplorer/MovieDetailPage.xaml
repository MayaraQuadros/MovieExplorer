<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MovieExplorer.MovieDetailPage"
             Title="MovieDetailPage">
    <VerticalStackLayout>
        <Label Text="Title" FontSize="Large" FontAttributes="Bold"/>
        <Label Text="Year" FontSize="Medium"/>
        <Label Text="Genre" FontSize="Medium"/>
        <Label Text="Year" FontSize="Director"/>
        <Label Text="Imdb" FontSize="Medium"/>
        <Button Text="Back" Clicked="BackButton_Clicked"/>

    </VerticalStackLayout>
</ContentPage>
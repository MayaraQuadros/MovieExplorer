<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MovieExplorer.MovieDetailPage"
             Title="MovieDetailPage">
    <VerticalStackLayout>
        <Label Text="{Binding Title}" FontSize="Large" FontAttributes="Bold"/>
        <Label Text="{Binding Year}" FontSize="Medium"/>
        <Label Text="{Binding Genre}" FontSize="Medium"/>
        <Label Text="{Binding Director}" FontSize="Medium"/>
        <Label Text="{Binding Imdb}" FontSize="Medium"/>
        <Button Text="Back" Clicked="BackButton_Clicked"/>

    </VerticalStackLayout>
</ContentPage>